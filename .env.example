# Server access token — generate with: python scripts/generate_token.py
SERVER_TOKEN=

# Fernet key for encrypting stored OAuth tokens — generate with: python scripts/generate_token.py
FERNET_KEY=

# Strava app credentials from https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Garmin auth uses a one-time manual SSO ticket paste — no email/password here.
# Run: uv run python scripts/setup_garmin_auth.py

# Storage
DATABASE_PATH=data/mcp.db

# Server
HOST=0.0.0.0
PORT=8000
